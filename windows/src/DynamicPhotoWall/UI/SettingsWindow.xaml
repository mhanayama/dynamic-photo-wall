<Window x:Class="DynamicPhotoWall.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Photo Wall — 設定" Icon="/DynamicPhotoWall;component/Assets/PhotoWall.ico"
        Width="1040" Height="820" MinWidth="920" MinHeight="700"
        Background="#14161C" Foreground="#E8EAF0" FontFamily="Yu Gothic UI, Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8EAF0"/><Setter Property="Margin" Value="0,5,0,7"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="#9CA6B9"/><Setter Property="FontSize" Value="12"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8EAF0"/><Setter Property="Margin" Value="0,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#252A36"/><Setter Property="Foreground" Value="#F5F6FA"/><Setter Property="BorderBrush" Value="#465066"/><Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="MinWidth" Value="120"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="17,8"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="Background" Value="#D9E4FF"/><Setter Property="Foreground" Value="#182239"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,12"/><Setter Property="Foreground" Value="#B9C3D4"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Width" Value="160"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="NavItem" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,3,8,3">
                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Left"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavItem" Property="Background" Value="#252A36"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavItem" Property="Background" Value="#294875"/><Setter Property="Foreground" Value="White"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/></Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Dynamic Photo Wall" FontSize="30" FontWeight="SemiBold" Margin="0"/>
            <TextBlock Text="いつものデスクトップを、静かなフォトギャラリーに。" Style="{StaticResource Hint}"/>
        </StackPanel>
        <TabControl x:Name="SettingsPages" Grid.Row="1" TabStripPlacement="Left" Background="#1C202A" BorderBrush="#333B4C" Padding="20">
            <TabItem Header="一般"><ScrollViewer><StackPanel>
                <TextBlock Text="一般" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="起動時の動作を設定し、再生を操作します。" Style="{StaticResource Hint}"/>
                <TextBlock Text="起動時の動作" FontSize="16" Margin="0,16,0,4"/>
                <CheckBox Content="Windowsログオン時に自動起動" IsChecked="{Binding AutoStart}"/>
                <CheckBox Content="アプリ起動時にスライドショーを開始" IsChecked="{Binding StartOnLaunch}"/>
                <TextBlock Text="再生操作" FontSize="16" Margin="0,20,0,4"/>
                <WrapPanel Margin="0,16,0,0">
                    <Button Content="表示停止" Click="StopClicked"/>
                    <Button Content="一時停止 / 再開" Click="PauseClicked"/>
                    <Button Content="次の構成" Click="NextClicked"/>
                </WrapPanel>
                <TextBlock Text="設定画面を閉じても再生は続きます。終了はタスクトレイのメニューから操作できます。" Style="{StaticResource Hint}"/>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="使用ディスプレイ"><ScrollViewer><StackPanel>
                <TextBlock Text="使用するディスプレイ" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="写真を表示する画面にチェックを入れてください。" Style="{StaticResource Hint}" Margin="0,4,0,20"/>
                <ContentControl x:Name="DisplaySelectionHost"/>
                <TextBlock x:Name="ConnectionStatus" Style="{StaticResource Hint}" Margin="0,16,0,4"/>
                <Button Content="ディスプレイを再検出" Click="RefreshDisplays" HorizontalAlignment="Left"/>
                <TextBlock Text="タスクバーを隠す画面" FontSize="16" Margin="0,20,0,4"/>
                <TextBlock Text="チェックした画面だけ、再生中にタスクバーを隠します。" Style="{StaticResource Hint}"/>
                <ContentControl x:Name="TaskbarSettingsHost"/>
                <TextBlock Text="画面をつなげて表示する場合は「画面グルーピング」で設定します。" Style="{StaticResource Hint}" Margin="0,20,0,0"/>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="画面グルーピング"><ScrollViewer><StackPanel>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center"><TextBlock Text="テストパターン" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                        <Button x:Name="TestPatternButton" Content="表示" Click="TestPatternClicked" Margin="0,4,0,4" ToolTip="保存せずに、現在の選択と配置を確認します。"/>
                    </WrapPanel>
                    <TextBlock Text="画面グルーピング" FontSize="24" FontWeight="SemiBold"/>
                </DockPanel>
                <TextBlock Text="同じグループの画面をつなぎます。単独なら「独立して表示」。カードはドラッグで配置できます。" Style="{StaticResource Hint}" Margin="0,4,0,16"/>
                <ContentControl x:Name="DisplayEditorHost"/>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="写真"><ScrollViewer><StackPanel>
                <TextBlock Text="写真フォルダー" FontSize="20"/>
                <ListBox x:Name="FolderList" Height="190" Background="#252A36" Foreground="White" Padding="8"/>
                <WrapPanel><Button Content="フォルダー追加" Click="AddFolder"/><Button Content="選択を削除" Click="RemoveFolder"/></WrapPanel>
                <CheckBox Content="サブフォルダーも検索" IsChecked="{Binding Recursive}"/>
                <CheckBox Content="ランダムに再生" IsChecked="{Binding RandomOrder}"/>
                <TextBlock Text="再表示を抑制する直近の写真数"/>
                <TextBox Text="{Binding RecentCount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                <TextBlock Text="JPEG / PNG / WebP対応。HEICはWindowsの対応コーデックが必要です。写真はPC内で処理されます。" Style="{StaticResource Hint}"/>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="表示モード"><ScrollViewer><StackPanel>
                <TextBlock Text="表示モード" FontSize="20"/>
                <TextBlock Text="右側にチェックすると、そのモードだけ画面ごとに写真と配置を作ります。チェックなしはグループ全体にスパンします。" Style="{StaticResource Hint}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding GalleryEnabled}"><TextBlock Text="Gallery — 複数の写真を並べる" Margin="0"/></CheckBox>
                    <CheckBox Grid.Column="1" x:Name="GalleryPerDisplayCheck" Content="ディスプレイごとに表示" IsChecked="{Binding GalleryPerDisplay}"/>
                </Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding GalleryScrollEnabled}"><TextBlock Text="Scrolling Gallery — 新しい写真が横から流れてくる" Margin="0"/></CheckBox>
                    <CheckBox Grid.Column="1" x:Name="GalleryScrollPerDisplayCheck" Content="ディスプレイごとに表示" IsChecked="{Binding GalleryScrollPerDisplay}"/>
                </Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding VerticalPanEnabled}"><TextBlock Text="Vertical Pan — 縦写真を上下に見せる" Margin="0"/></CheckBox>
                    <CheckBox Grid.Column="1" x:Name="VerticalPanPerDisplayCheck" Content="ディスプレイごとに表示" IsChecked="{Binding VerticalPanPerDisplay}"/>
                </Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding HorizontalPanEnabled}"><TextBlock Text="Horizontal Pan — パノラマを左右に見せる" Margin="0"/></CheckBox>
                    <CheckBox Grid.Column="1" x:Name="HorizontalPanPerDisplayCheck" Content="ディスプレイごとに表示" IsChecked="{Binding HorizontalPanPerDisplay}"/>
                </Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding ZoomEnabled}"><TextBlock Text="Cinematic Zoom — ゆっくり拡大・縮小" Margin="0"/></CheckBox>
                    <CheckBox Grid.Column="1" x:Name="ZoomPerDisplayCheck" Content="ディスプレイごとに表示" IsChecked="{Binding ZoomPerDisplay}"/>
                </Grid>
                <CheckBox x:Name="AvoidFaceDisplayBoundariesCheck" Content="スパン時に顔が画面の境目に重ならないよう配置" IsChecked="{Binding AvoidFaceDisplayBoundaries}"/>
                <TextBlock Text="Galleryの停止後の配置・Vertical Panで顔を画面内へ収めます。位置の調整だけで収まらない場合は写真を小さくします。Galleryの再配置中や横スクロール・横パンは境界を通過します。" Style="{StaticResource Hint}"/>
                <TextBlock Text="抽選ウェイト（0で抽選対象から除外）"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="Gallery"/><TextBox Text="{Binding GalleryWeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Pan（縦・横の合計）"/><TextBox Text="{Binding PanWeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Zoom"/><TextBox Text="{Binding ZoomWeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
                </Grid>
                <TextBlock Text="Galleryの最大枚数（1〜20）"/>
                <TextBox Text="{Binding GalleryMax, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                <TextBlock Text="パンで許容する拡大率（1〜12倍、初期値4倍）"/>
                <TextBox Text="{Binding MaxPanUpscale, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                <TextBlock Text="縦パンの表示幅（画面幅の割合、0.3〜1.0）"/>
                <TextBox Text="{Binding PanWidthFraction, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                <CheckBox Content="顔が見える位置で縦パンを止める" IsChecked="{Binding StopAtFace}"/>
                <CheckBox Content="全画面表示でも顔が見える位置を優先" IsChecked="{Binding FaceAwareFraming}"/>
                <TextBlock Text="縦パンでスパン幅への拡大率が上限を超えても各画面に収まる写真は、同じ写真を各ディスプレイへ自動でミラー表示します。各画面でも上限を超える写真はパンの候補から外れます。" Style="{StaticResource Hint}"/>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="動き"><ScrollViewer><StackPanel>
                <TextBlock Text="ゆったりとしたモーション" FontSize="20"/>
                <CheckBox Content="顔の反対側からパンを開始する" IsChecked="{Binding FaceAwarePanDirection}"/>
                <TextBlock Text="パン速度（物理px / 秒、5〜500）"/><TextBox Text="{Binding PanPixelsPerSecond, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                <TextBlock Text="Scrolling Galleryの速度（px / 秒、5〜200）"/><TextBox Text="{Binding GalleryScrollPixelsPerSecond, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                <TextBlock Text="ズームの所要時間（秒、10〜600）"/><TextBox Text="{Binding ZoomSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                <TextBlock Text="最大ズーム倍率（1.0〜1.15）"/><TextBox Text="{Binding MaxZoom, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                <TextBlock Text="クロスフェード（秒、0.2〜10）"/><TextBox Text="{Binding FadeSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                <TextBlock Text="Galleryの更新間隔 — 最短（秒）"/><TextBox Text="{Binding GalleryMinSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                <TextBlock Text="Galleryの更新間隔 — 最長（秒）"/><TextBox Text="{Binding GalleryMaxSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="見た目"><ScrollViewer><StackPanel>
                <TextBlock Text="写真の見せ方" FontSize="20"/>
                <CheckBox Content="表示中の写真に追従するガラス風の背景" IsChecked="{Binding GlassBackground}"/>
                <TextBlock Text="背景色（例：#101116）"/><TextBox Text="{Binding Background, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="写真の間隔（px）"/><TextBox Text="{Binding Gap, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                <TextBlock Text="写真の角丸（px、0で無効）"/><TextBox Text="{Binding CornerRadius, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                <CheckBox Content="ファイル名・解像度・撮影日時を表示" IsChecked="{Binding ExifOverlay}"/>
                <TextBlock Text="画像キャッシュ予算（MiB、64〜1024）"/><TextBox Text="{Binding CacheMegabytes, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                <TextBlock Text="グループ内の全画面が同じ最大化アプリなどで覆われた間は、そのグループのモーションを一時停止します。ほかのグループは再生を続けます。" Style="{StaticResource Hint}"/>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="ネットワーク"><ScrollViewer><ContentControl x:Name="NetworkPanelHost"/></ScrollViewer></TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="#ADCAFF" Margin="0,16,0,6"/>
        <DockPanel Grid.Row="3">
            <TextBlock Text="設定の変更は保存時に反映" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="保存して表示開始" Click="StartClicked"/><Button x:Name="SaveButton" Content="保存して適用" Click="SaveClicked"/><Button Content="閉じる" Click="CloseClicked" Margin="0,4,0,4"/></StackPanel>
        </DockPanel>
    </Grid>
</Window>

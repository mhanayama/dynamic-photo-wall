<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/PhotoWall-apple-style.ico</ApplicationIcon>
    <AssemblyName>DynamicPhotoWall</AssemblyName>
    <Version>0.1.0</Version>
    <!-- WPF owns DPI; WinForms is used only for NotifyIcon and folder selection. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../DynamicPhotoWall.Core/DynamicPhotoWall.Core.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../../../shared/DynamicPhotoWall.Networking/DynamicPhotoWall.Networking.csproj" /></ItemGroup>
  <ItemGroup><PackageReference Include="SkiaSharp" Version="3.119.4" /></ItemGroup>
  <ItemGroup><Resource Include="../../assets/PhotoWall-apple-style.ico" Link="Assets/PhotoWall.ico" /></ItemGroup>
</Project>
